# Templated by nginx:alpine's own envsubst-on-startup behavior (see
# Dockerfile alongside this file) — ${PORT} becomes whatever Cloud Run
# actually assigned this instance.
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Default: always revalidate. Safe baseline for every file this
  # config doesn't explicitly override below — nginx's own ETag/
  # Last-Modified still lets an unchanged file come back as a cheap 304
  # instead of a full re-download, so this isn't "no caching", just
  # "never trust a filename alone to mean the content can't have
  # changed" (see the immutable-cache exception below for why that
  # distinction matters here specifically). `location` blocks below
  # that don't set their own add_header inherit this one; the one that
  # does replaces it entirely for matching requests — that's nginx's
  # documented add_header inheritance behavior, not an oversight.
  add_header Cache-Control "no-cache" always;

  # SPA fallback: any path that isn't a real file falls back to
  # index.html so client-side routing (go_router in the Flutter apps,
  # Angular's router in marketing) can handle it — matches
  # firebase.json's per-target rewrite rule exactly.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # The one safe exception: filenames a build tool actually
  # content-hashed (Angular emits e.g. main-<hash>.js, styles-<hash>.css
  # — matched below by the trailing hash-looking segment). Confirmed for
  # real that Flutter's own web build output does NOT follow this
  # convention — main.dart.js, flutter.js, flutter_bootstrap.js,
  # flutter_service_worker.js keep the exact same filename on every
  # deploy — so it correctly falls through to the no-cache default
  # above instead of matching here. An earlier version of this file
  # keyed off file extension alone (any .js/.css/etc.), which caught
  # those Flutter filenames — and marketing's own unhashed
  # manifest.json/favicon.ico — in a year-long immutable cache, exactly
  # the staleness bug this whole rule exists to avoid.
  #
  # The pattern is quoted, unlike the try_files args above — confirmed
  # for real this isn't optional: nginx's config tokenizer treats an
  # unquoted `{` as starting a block even mid-regex, so the bare
  # `{8,}` quantifier crashed nginx at startup with "unknown directive
  # \"8,}...\"" (it read `location ~* -[0-9a-zA-Z]{` as the location's
  # own opening brace, then choked trying to parse the regex remainder
  # as a directive name). Quoting the whole pattern is the standard fix.
  location ~* "-[0-9a-zA-Z]{8,}\.(?:js|css|png|jpg|jpeg|gif|svg|webp|woff2?|ttf|eot|ico|json|wasm)$" {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }
}
