rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // A single `get()` on the caller's own profile — Firestore's rules
    // engine dedupes repeated calls to this within one rule evaluation into
    // one actual read, so calling this multiple times per request (e.g. via
    // both isSuperAdmin() and callerOrgId()) doesn't cost extra reads.
    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Bypasses org isolation everywhere except where explicitly withheld —
    // see functions/src/index.ts's getCallerProfile/requireSuperAdmin for
    // the server-side equivalent. A super-admin's own profile deliberately
    // has no `organizationId` field at all (see UserProfile's comment).
    function isSuperAdmin() {
      return isSignedIn() && ('super-admin' in callerDoc().get('role', []));
    }

    function callerOrgId() {
      return callerDoc().get('organizationId', null);
    }

    function sameOrgAsCaller(orgId) {
      return isSignedIn() && orgId == callerOrgId();
    }

    // `role` is a list (a user can hold more than one) — see isSuperAdmin
    // above, which checks it the same way. Mirrors the server-side role
    // checks in functions/src/admin.ts (requireAdmin etc.).
    function callerHasRole(role) {
      return isSignedIn() && (role in callerDoc().get('role', []));
    }

    // Same get()-another-document pattern as callerDoc() above, applied to
    // organizations/{orgId} instead of the caller's own profile.
    function orgRequiresCmek(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.get('cmekRequested', false) == true;
    }

    // Defense-in-depth for the patients rules below: a shape check, not a
    // cryptographic guarantee (rules can't verify a blob actually decrypts
    // correctly, only that it looks like one) — see functions/src/kms.ts's
    // EncryptedField for what `__enc: 1` means. Real value is that even a
    // bypassed/buggy EMS client can't silently write plaintext name/
    // healthcareNumber for an org that requested Canadian data residency;
    // the actual encryption decision still lives server-side in
    // functions/src/patients.ts's encryptPatientFields.
    function fieldsRespectCmek(data) {
      return !orgRequiresCmek(data.organizationId)
        || (data.name is map && data.name.get('__enc', null) == 1
            && data.healthcareNumber is map && data.healthcareNumber.get('__enc', null) == 1);
    }

    // Every user's own profile lives here, including their assigned `role`
    // and `organizationId`. Both are only ever set by Cloud Functions (Admin
    // SDK, bypasses these rules) — clients are explicitly blocked from
    // creating or changing either field themselves. NOTE: Firestore rules
    // are OR'd across every matching `match` block for a given path, so this
    // collection deliberately has no other rule matching it (no blanket
    // `{document=**}` catch-all) — that would otherwise re-permit the writes
    // this block exists to block.
    match /users/{userId} {
      allow get: if isSuperAdmin()
        || request.auth.uid == userId
        || sameOrgAsCaller(resource.data.get('organizationId', null));
      // Org-scoped listing goes through the listUsersWithRoles Cloud
      // Function (Admin SDK), not a direct client query — only a super-admin
      // ever legitimately needs to list this collection directly.
      allow list: if isSuperAdmin();
      allow create: if request.auth.uid == userId
        && !('role' in request.resource.data)
        && !('organizationId' in request.resource.data);
      allow update: if request.auth.uid == userId
        && request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('organizationId', null) == resource.data.get('organizationId', null);
      allow delete: if request.auth.uid == userId;
    }

    // Organizations are only ever written by the createOrganization Cloud
    // Function (Admin SDK, bypasses these rules) — no client, including a
    // regular org admin, ever creates or edits one directly.
    match /organizations/{orgId} {
      allow get: if isSuperAdmin() || sameOrgAsCaller(orgId);
      allow list: if isSuperAdmin();
      allow write: if false;
    }

    // Reads stay open to any same-org member — physicians/nurses need to
    // see incoming patients (physician/lib/services/patient_service.dart is
    // read-only). Writes are restricted to the `ems` role: EMS is the only
    // client that creates/edits/completes patient records
    // (ems/lib/services/patient_upload_service.dart), and without this a
    // same-org physician/nurse/admin could falsify vitals straight through
    // the SDK, bypassing the app UI.
    //
    // create/update also require createdBy/updatedBy to name the actual
    // writer (never a claimed-on-behalf-of-someone-else uid) — those are
    // the only signal functions/src/patients.ts's onPatientCreated/
    // onPatientUpdated triggers have to attribute an audit log entry to a
    // real person, since a Firestore trigger carries no request.auth of its
    // own. createdBy is additionally immutable post-create, same pattern as
    // organizationId just below it.
    //
    // Deletes are blocked entirely here — patients.ts's deletePatientRecord
    // Cloud Function is the only way to delete a patient record, so every
    // delete has a guaranteed request.auth-backed audit entry instead of
    // one inferred (unreliably) from a trigger. cleanupCompletedPatients'
    // scheduled retention sweep still works: it deletes via the Admin SDK,
    // which bypasses these rules entirely.
    match /patients/{patientId} {
      allow read: if isSuperAdmin() || sameOrgAsCaller(resource.data.get('organizationId', null));
      // Only ever written by the uploadPatientDocument Cloud Function (Admin
      // SDK, bypasses these rules) — creating a new patient also has to
      // atomically seed this patient's initial location subdocument below,
      // which firestore.rules blocks a direct client write to entirely, so
      // both writes need to happen together server-side. Edits stay a
      // direct client write (offline queueing matters most for those,
      // in-the-field — see the function's own doc comment).
      allow create: if false;
      allow update: if callerHasRole('ems')
        && sameOrgAsCaller(resource.data.get('organizationId', null))
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.get('updatedBy', null) == request.auth.uid
        && fieldsRespectCmek(request.resource.data);
      allow delete: if false;

      // An append-only log of every distinct vitals reading this patient
      // has had — only ever written by onPatientCreated/onPatientUpdated
      // (Admin SDK; functions/src/patients.ts). Unlike location, this is
      // only ever read per-patient (browsing one open patient's history),
      // never org-wide, so there's no need to denormalize organizationId
      // onto each entry — a single get() on the parent, same as every
      // other per-patient read in this file, is enough.
      match /vitalsHistory/{entryId} {
        allow read: if isSuperAdmin() || sameOrgAsCaller(get(/databases/$(database)/documents/patients/$(patientId)).data.get('organizationId', null));
        allow write: if false;
      }
    }

    // The patient's live GPS position — a sibling document rather than a
    // field on the patient doc itself, specifically so a location update
    // (as often as every ~15s, for the life of a transport) never fires
    // onPatientUpdated's audit trigger or re-emits the listener the whole
    // patient list watches (a Firestore subcollection write is invisible to
    // both). Only ever written by onEmsLocationEvent/uploadPatientDocument
    // (Admin SDK) — no client writes here directly. A top-level wildcard
    // match (`{path=**}`) rather than nested inside `match /patients
    // /{patientId}` above — confirmed via a real failure that the nested
    // form doesn't authorize a collectionGroup('location') query (see
    // EmsLocationController on the physician client): it throws
    // permission-denied even though the identical resource.data-based
    // check works fine for a plain, non-collection-group query (like
    // `patients`'s own list query above). The wildcard form is Firestore's
    // documented pattern for securing collection group reads. organizationId
    // is denormalized onto this document rather than resolved from the
    // parent since a collection-group read has no cheap way to look up its
    // own parent.
    match /{path=**}/location/{locationId} {
      allow read: if isSuperAdmin() || sameOrgAsCaller(resource.data.get('organizationId', null));
      allow write: if false;
    }

    // Hospitals are only ever written by the createHospital/deleteHospital
    // Cloud Functions (Admin SDK, bypasses these rules) so an admin-only,
    // org-scoped write can be enforced server-side (including geocoding the
    // address) — clients, including the admin app itself, never write here
    // directly.
    match /hospitals/{hospitalId} {
      allow read: if isSuperAdmin() || sameOrgAsCaller(resource.data.get('organizationId', null));
      allow write: if false;
    }

    // Written only by admin.ts's Cloud Functions (Admin SDK, bypasses these
    // rules) as a side effect of createUser/updateUser/deleteUser/
    // setUserDisabled/resendInvite/setUserRole/removeUserRole/
    // createHospital/deleteHospital/createOrganization/
    // setOrganizationRetention, and read back only through the
    // listAuditLog Cloud Function — no client access at all, unlike
    // hospitals/organizations above (which at least allow a direct read).
    match /auditLog/{entryId} {
      allow read, write: if false;
    }
  }
}
